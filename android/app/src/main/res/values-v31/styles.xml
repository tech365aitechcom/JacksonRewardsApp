<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 12+ (API 31) splash screen overrides.
    On Android 12+, the OS always shows a system-managed splash screen before the
    Activity draws. These attributes configure that system splash.
    windowSplashScreen* attributes are API 31+ only, so they must live here.
-->
<resources>
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.AppCompat.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>

        <!-- System splash screen background color (shown by OS before Activity draws) -->
        <item name="android:windowSplashScreenBackground">#000000</item>
        <!-- App icon shown centered on the splash background -->
        <item name="android:windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_foreground</item>
        <!-- How long the icon animation plays (ms) -->
        <item name="android:windowSplashScreenAnimationDuration">1000</item>

        <!-- Activity window background while WebView initializes after system splash -->
        <item name="android:background">@drawable/splash</item>
        <item name="android:statusBarColor">#000000</item>
        <item name="android:navigationBarColor">#000000</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
</resources>
