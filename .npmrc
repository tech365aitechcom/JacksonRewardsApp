# The app is on Capacitor 7, but @capacitor-community/advertising-id and
# @capacitor-firebase/authentication declare a peer dependency on Capacitor 8.
# npm 7+ treats that as a hard failure, so a plain `npm install` aborts on a
# fresh clone and the build then fails with "next is not recognized".
#
# The combination works at runtime - the plugins only use APIs Capacitor 7
# provides - so relax peer resolution rather than forcing everyone to remember
# --legacy-peer-deps. Remove this once the app moves to Capacitor 8.
legacy-peer-deps=true
