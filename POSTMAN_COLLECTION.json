{
  "info": {
    "name": "Biometric API Testing",
    "description": "Complete Postman collection for testing biometric endpoints",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Login (Get Token)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"emailOrMobile\": \"919999988888\",\n  \"password\": \"your_password_here\"\n}"
        },
        "url": {
          "raw": "https://rewardsuatapi.hireagent.co/api/auth/login",
          "protocol": "https",
          "host": ["rewardsapi", "hireagent", "co"],
          "path": ["api", "auth", "login"]
        },
        "description": "Login first to get JWT token. Copy the token from response."
      },
      "response": []
    },
    {
      "name": "2. Setup Biometric (Register Face ID)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}",
            "type": "text",
            "description": "Replace {{token}} with JWT token from login"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"mobile\": \"919999988888\",\n  \"type\": \"face_id\",\n  \"deviceId\": \"test-device-postman-123\",\n  \"verificationData\": {\n    \"livenessScore\": 1.0,\n    \"faceMatchScore\": 1.0\n  }\n}"
        },
        "url": {
          "raw": "https://rewardsuatapi.hireagent.co/api/biometric/setup",
          "protocol": "https",
          "host": ["rewardsapi", "hireagent", "co"],
          "path": ["api", "biometric", "setup"]
        },
        "description": "Register biometric authentication. Check response for success and biometric data."
      },
      "response": []
    },
    {
      "name": "3. Check Biometric Status",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "https://rewardsuatapi.hireagent.co/api/biometric/status?mobile=919999988888",
          "protocol": "https",
          "host": ["rewardsapi", "hireagent", "co"],
          "path": ["api", "biometric", "status"],
          "query": [
            {
              "key": "mobile",
              "value": "919999988888",
              "description": "User mobile number"
            }
          ]
        },
        "description": "Check if biometric is registered. Should return isRegistered: true after setup."
      },
      "response": []
    },
    {
      "name": "4. Biometric Login",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"mobile\": \"919999988888\",\n  \"deviceId\": \"test-device-postman-123\",\n  \"biometricType\": \"face_id\"\n}"
        },
        "url": {
          "raw": "https://rewardsuatapi.hireagent.co/api/biometric/biometric-login",
          "protocol": "https",
          "host": ["rewardsapi", "hireagent", "co"],
          "path": ["api", "biometric", "biometric-login"]
        },
        "description": "Login using biometric. Should work if registration was successful."
      },
      "response": []
    },
    {
      "name": "5. Reset Biometric",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"mobile\": \"919999988888\"\n}"
        },
        "url": {
          "raw": "https://rewardsuatapi.hireagent.co/api/biometric/reset",
          "protocol": "https",
          "host": ["rewardsapi", "hireagent", "co"],
          "path": ["api", "biometric", "reset"]
        },
        "description": "Reset biometric settings. Use this to clear registration for testing."
      },
      "response": []
    }
  ],
  "variable": [
    {
      "key": "token",
      "value": "",
      "type": "string"
    },
    {
      "key": "mobile",
      "value": "919999988888",
      "type": "string"
    }
  ]
}
