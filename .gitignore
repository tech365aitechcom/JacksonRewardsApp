# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# Allow .env.example to be committed (it's a template)
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Android sensitive files
android/app/google-services.json

# Local tools and editor state
/.claude/
/.codex/
/.agents/
/.vscode/
**/.idea/

# Build output, crash reports, and signing material
/release/
*.apk
*.aab
*.log
*.hprof
*.jks
*.keystore
*.p12
*.pfx
**/key.properties
**/keystore.properties
hs_err_pid*
replay_pid*

# Internal reference material and one-off backend patches
/*.pdf
/*.csv
/*.postman_collection*.json
/ALTERNATIVE_UPDATE_METHOD.js
/UPDATED_BIOMETRIC_SCHEMA.js
/routes/biometric-fixed.js
/assets/c__Users_*
/app/(onboarding)/select-age/draft.jsx
